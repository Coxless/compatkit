{
  "name": "compatkit",
  "version": "0.1.0",
  "description": "Local compatibility test runner for framework-targeting packages",
  "keywords": [
    "compatibility",
    "matrix",
    "nextjs",
    "react",
    "testing",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "compat": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify:node": "node dist/cli.js test",
    "check": "bun run typecheck && bun run lint && bun test && bun run build && bun run verify:node"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2"
  }
}
